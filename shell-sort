#include <stdio.h>
#include <stdlib.h>
#include <time.h>
 
void show_data(int* arr, long len) {
	for (long i = 0; i < len; i++) {
		printf("%3d", arr[i]);
		if ((i + 1) % 15 == 0) {
			printf("\n");
		}
	}
	if (len % 10 != 0) {
		printf("\n");
	}
	printf("\n");
}
 
 
inline void swap(int* a, int* b) {
	int tmp = *a;
	*a = *b;
	*b = tmp;
}
 
void shell_sort(int* array, long LEN) {
	const int gaps[] = { 701,301,132,57,23,10,4,1 };
	const int gap_len = 8;
	long j;
	for (long g = 0; g < gap_len; g++) {
		int gap = gaps[g];
 
		if (gap >= LEN) {
			printf("===== 步长 %d ≥ 数组长度，跳过 =====\n\n", gap);
			continue;
		}
		 //打印当前步长
		printf("===== 当前排序步长：%d =====\n", gap);
 
		for (long i = gap; i < LEN; i++) {
			int tmp = array[i];
			for (j = i; j >= gap && (array[j - gap] - tmp) > 0; j -= gap) {
				array[j] = array[j - gap];
			}
			array[j] = tmp;
		}
		printf("步长 %d 排序完成，当前数组：\n", gap);
		show_data(array, LEN);
	}
}
 
 
 
int main(int argc ,char*argv[]) {
	int i;
	long size = 20;
	if (argc == 2) {
		size = atoi(argv[1]);
	}
	else if (argc > 2) {
		printf("参数错误!\n");
	}
	int* array = (int*)malloc(size * sizeof(int));
	if (array == NULL) {
		printf("内存分配失败!\n");
		return 1;
	}
	int range = 100;
	double time_spent;
	srand((unsigned int)time(NULL));
	for (i = 0; i < size; i++) {
		array[i] = rand() % range;
	} 
 
	printf("\n======== 排序前数组 ========\n");
	show_data(array, size);
	clock_t t1 = clock();
	shell_sort(array, size);
	clock_t t2 = clock();
 
	time_spent = (double)(t2 - t1) / CLOCKS_PER_SEC;
 
	printf("\n======== 排序后数组 ========\n");
	show_data(array, size);
 
	printf("排序用时：%.6f 秒\n",time_spent);
	free(array);
	return 0;
}
