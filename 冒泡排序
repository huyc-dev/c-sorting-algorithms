#include <stdio.h>

static void bubble_sort(int arr[], int n) {
	for (int i = 0; i < n - 1; i++) {

		printf("\n===== 第%d轮冒泡排序 =====\n",i+1);

		int swapped = 0;
		for (int j = 0; j < n - i - 1; j++) {
			if (arr[j] > arr[j + 1]) {

				printf("交换元素: %d <-> %d", arr[j], arr[j + 1]);

				int temp = arr[j];
				arr[j] = arr[j + 1];
				arr[j + 1] = temp;
				swapped = 1;

				printf(" -> 数组变为: ");
				for (int k = 0; k < n; k++) {
					printf("%d ", arr[k]);
				}
				printf("\n");
			}
		}
		if (swapped == 0)  break;
	}
}

int main() {
	int arr[] = { 64,34,25,12,22,11,90 };
	int n = sizeof(arr) / sizeof(arr[0]);

	printf("初始数组: ");
	for (int i = 0; i < n; i++) {
		printf("%d ", arr[i]);
	}
	printf("\n");

	bubble_sort(arr, n);

	printf("\n排序完成: ");
	
	for (int i = 0; i < n; i++) {
		printf("%d ",arr[i]);
	}
	
	return 0;
}
