#include <stdio.h>
#include <string.h>
#include <stdlib.h>

void printf_array_strings(char* arr[], int n) {
	for (int i = 0; i < n; i++) {
		printf("%s ", arr[i]);
	}
	printf("\n");
}

void select_sort_strings(char* arr[], int n) {
	for (int i = 0; i < n ; i++) {
		int min_index = i;
		for (int j = i + 1; j < n; j++) {
			if (strcmp(arr[j], arr[min_index]) < 0) {
				min_index = j;
			}
		}
		char* temp = arr[i];
		arr[i] = arr[min_index];
		arr[min_index] = temp;
	}
}

int main() {
	char* unsorted_array_strings[5] = { "date","banana","fig","cherry","apple" };
	int n = sizeof(unsorted_array_strings) / sizeof(unsorted_array_strings[0]);
	printf("Original array: ");
	printf_array_strings(unsorted_array_strings, n);
	select_sort_strings(unsorted_array_strings, n);
	printf("Sorted array: ");
	printf_array_strings(unsorted_array_strings, n);
	return 0;
}
